{
  "name": "worksight-app",
  "private": true,
  "version": "1.0.0",

  "main": "src/electron/main.js",

  "scripts": {
    "react": "vite",
    "java": "mvn exec:java -Dexec.mainClass=com.worksight.Main",
    "electron": "electron src/electron/main.js",
    "dev": "concurrently \"npm run java\" \"npm run react\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "vite build"
  },

  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1"
  },

  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.3",
    "vite": "^8.0.9",
    "wait-on": "^9.0.5"
  }
}